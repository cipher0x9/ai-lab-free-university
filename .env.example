# AI Lab Free University — env template
# Copy to .env and fill locally. NEVER commit .env.

# Optional: Ollama base URL (default http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: preferred local model tag
OLLAMA_MODEL=llama3.2:3b

# Optional cloud (Phase 3+) — leave blank for Phase 1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Safety defaults
AI_LAB_ALLOW_NETWORK=0
AI_LAB_REQUIRE_HUMAN_APPROVAL=1
